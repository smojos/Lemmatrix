# Lemmatrix's .gitignore (the audit, section 8, step 9; 26 October 2026). Written for this
# repository rather than the generic Python template, which would also have hidden things v1's
# installer may need: a PyInstaller .spec, a Windows .manifest, a lib/ folder, translations
# (.mo, .pot).

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
dist/

# tools
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.cursorignore
.cursorindexingignore

# Lemmatrix writes these beside a database or the program while it runs
lemmatrix-errors.log
lemmatrix-crash.log
Backups/
*.saving
*.part
*.lemmatrix-writing
*.lemmatrix-lock
screenshots/
/*.workspace

# secrets that must never be pushed
.env
.pypirc
