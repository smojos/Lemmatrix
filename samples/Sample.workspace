<?xml version="1.0" encoding="utf-8"?>
<workspace format="1" database="Sample.xml">
  <settings play-cell-on-click="no" pitch-style="contours" />
  <matrices>
    <matrix name="Nouns: citation, plural and frames" kind="lemma-tag" cell="drawing Phonetic Phonemic Translation">
      <x match="citation" />
      <x match="exact" tags="Plural" />
      <x match="exact" tags="Frame 1" />
      <x match="exact" tags="Frame 2" />
    </matrix>
    <matrix name="Nouns: number and possession" kind="tag-tag" cell="drawing Phonetic Phonemic Translation">
      <y match="exact" tags="Singular" />
      <y match="exact" tags="Plural" />
      <x match="exact" tags="1SG.POSS" />
      <x match="exact" tags="2SG.POSS" />
      <x match="exact" tags="3SG.POSS" />
      <x match="exact" tags="1PL.POSS" />
      <x match="exact" tags="2PL.POSS" />
      <x match="exact" tags="3PL.POSS" />
    </matrix>
    <matrix name="Verbs: imperatives" kind="lemma-tag" cell="drawing Phonetic Phonemic Translation">
      <x match="citation" />
      <x match="exact" tags="2SG.A, Imperative" />
      <x match="exact" tags="2PL.A, Imperative" />
      <x match="exact" tags="2SG.A, Imperative, Negative" />
      <x match="exact" tags="2PL.A, Imperative, Negative" />
    </matrix>
    <matrix name="Verbs: person and tense" kind="tag-tag" cell="drawing Phonetic Phonemic Translation">
      <y match="exact" tags="3SG.A, NP.O" />
      <y match="exact" tags="3PL.A, NP.O" />
      <x match="exact" tags="Present" />
      <x match="exact" tags="Past" />
      <x match="exact" tags="Future" />
    </matrix>
  </matrices>
</workspace>
