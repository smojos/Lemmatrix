        <group name="Preceding tone">
          <tag name="after H" code="Hx" />
          <tag name="after L" code="Lx" />
        </group>
      </group>
      <group name="Syntactic">
        <group name="Position vis predicate">
          <tag name="preverbal" code="PREV" />
          <tag name="postverbal" code="POSTV" />
          <tag name="non-verbal predicate" code="PRED" />
        </group>
        <group name="Utterance position">
          <tag name="isolation" default="yes" />
          <tag name="utterance-initial" code="INI" />
          <tag name="utterance-final" code="FIN" />
        </group>
      </group>
      <group name="Instances">
        <group name="Frames">
          <tag name="Frame 1" code="F1" />
          <tag name="Frame 2" code="F2" />
        </group>
        <group name="Examples">
          <tag name="Example 1" code="x1" />
          <tag name="Example 2" code="x2" />
        </group>
      </group>
