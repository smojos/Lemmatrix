        <group name="Tense">
          <tag name="Present" default="yes" />
          <tag name="Past" code="PST" />
          <tag name="Future" code="FUT" />
        </group>
        <group name="Aspect">
          <tag name="Perfective" default="yes" />
          <tag name="Imperfective" code="IPFV" />
        </group>
        <group name="Mood">
          <tag name="Indicative" default="yes" />
          <tag name="Imperative" code="IMP" />
          <tag name="Interrogative" code="INT" />
        </group>
        <group name="Polarity">
          <tag name="Affirmative" default="yes" />
          <tag name="Negative" code="NEG" />
        </group>
      </group>
      <group name="Phonological">
        <group name="Following tone">
          <tag name="before H" code="xH" />
          <tag name="before L" code="xL" />
