        </item>
        <item name="procedural" />
        <item name="hortatory" />
        <item name="expository" />
        <item name="conversation" />
        <item name="song" />
        <item name="prayer" />
        <item name="elicited" />
        <item name="other" />
      </field>
      <field name="Status" label="Transcription status" role="status" closed="yes">
        <item name="untranscribed" />
        <item name="transcribed" />
        <item name="translated" />
        <item name="analyzed" />
        <item name="finished" />
      </field>
      <field name="Description" />
      <field name="Comment" role="comment" />
    </text-fields>
    <tier-mapping main="tx">
      <tier name="tx" field="Phonetic" />
