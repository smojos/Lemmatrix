      <field name="InflectionClass" label="Inflection Class" closed="yes">
        <item name="Nominal">
          <item name="I" />
          <item name="II" />
        </item>
        <item name="Verbal">
          <item name="I" />
          <item name="II" />
        </item>
      </field>
      <field name="Comment" role="comment" />
