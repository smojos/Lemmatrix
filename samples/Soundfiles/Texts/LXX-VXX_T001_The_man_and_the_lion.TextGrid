        intervals [2]:
            xmin = 0.99 
            xmax = 2.78 
            text = "Today the man took a spear." 
        intervals [3]:
            xmin = 2.78 
            xmax = 3.81 
            text = "" 
        intervals [4]:
            xmin = 3.81 
            xmax = 5.15 
            text = "He saw a lion here." 
        intervals [5]:
            xmin = 5.15 
            xmax = 6.18 
            text = "" 
        intervals [6]:
            xmin = 6.18 
            xmax = 7.36 
            text = "It was a big lion." 
        intervals [7]:
            xmin = 7.36 
            xmax = 7.97 
            text = "" 
        intervals [8]:
            xmin = 7.97 
            xmax = 9.63 
            text = "The lion ate two goats." 
        intervals [9]:
            xmin = 9.63 
            xmax = 10.43 
            text = "" 
        intervals [10]:
            xmin = 10.43 
            xmax = 11.87 
            text = "The man called the children." 
        intervals [11]:
            xmin = 11.87 
            xmax = 12.58 
            text = "" 
        intervals [12]:
            xmin = 12.58 
            xmax = 13.95 
            text = "The children carried stones." 
        intervals [13]:
            xmin = 13.95 
            xmax = 15.01 
            text = "" 
        intervals [14]:
            xmin = 15.01 
            xmax = 16.60410300503467 
            text = "The man threw a stone." 
        intervals [15]:
            xmin = 16.60410300503467 
            xmax = 17.76 
            text = "He killed the lion." 
        intervals [16]:
            xmin = 17.76 
            xmax = 18.82 
            text = "" 
        intervals [17]:
            xmin = 18.82 
            xmax = 20.03 
            text = "The woman cooked the meat." 
        intervals [18]:
            xmin = 20.03 
            xmax = 20.61 
            text = "" 
        intervals [19]:
            xmin = 20.61 
            xmax = 22.21 
            text = "“We will eat lion meat today.”" 
